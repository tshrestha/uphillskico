---
// Prerendered trail map card. Links to the full-size map; with scripts it
// opens the zoomable viewer instead (src/maps-grid.js reads the viewer's
// data from the card: href, thumbnail src, name and data-rank).
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import RankBadge from "./RankBadge.astro";
import { getRankTier } from "../shared.js";
import {
  getMapImage,
  getFullSrc,
  THUMB,
  THUMB_WIDTHS,
  THUMB_SIZES,
} from "../data/trailmap-images.js";

/**
 * @typedef {object} Props
 * @property {{ name: string, file: string, rank?: number }} map - Entry from src/trailmaps-data.js
 * @property {number} index - Position in the grid
 */
const { map, index } = /** @type {Props} */ (Astro.props);
---

<a
  class={`map-card t${getRankTier(map.rank)}`}
  href={getFullSrc(map.file)}
  data-index={index}
  data-rank={map.rank}
  style={`--n:${index}`}
>
  <span class="map-thumb">
    <Image
      src={getMapImage(map.file)}
      {...THUMB}
      widths={THUMB_WIDTHS}
      sizes={THUMB_SIZES}
      alt=""
      {...(index === 0
        ? { priority: true }
        : { loading: index < 8 ? "eager" : "lazy", decoding: "async" })}
    />
    <span class="map-zoom">
      <Icon name="plus" />
    </span>
  </span>
  <span class="map-info">
    <RankBadge rank={map.rank} />
    <span class="map-name">{map.name}</span>
    <span class="visually-hidden"> trail map</span>
    <Icon name="arrow-up-right" />
  </span>
</a>
