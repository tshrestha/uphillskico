---
// JSON-LD structured data, serialised from an object. `is:inline` keeps it
// out of Astro's script bundling; it is data, never executed, so the CSP
// `script-src 'self'` doesn't apply. `<` is escaped so no string in the data
// can close the <script> element.
/**
 * @typedef {{
 *   data: object;
 * }} Props
 */
const json = JSON.stringify(Astro.props.data).replace(/</g, "\\u003c");
---

<script is:inline type="application/ld+json" set:html={json} />
