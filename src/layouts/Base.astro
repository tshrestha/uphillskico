---
// Shared page shell: <head> metadata, critical CSS, icon sprite, header and
// footer. Every public page renders through this layout so its canonical URL
// comes from the page registry and its share preview uses the same image.
import "../styles/site.css";
import Sprite from "../components/Sprite.astro";
import Icon from "../components/Icon.astro";
import { SITE, canonicalUrl } from "../data/pages.js";

/**
 * @typedef {object} Props
 * @property {string} path - Public path, as listed in src/data/pages.js
 * @property {string} title
 * @property {string} description
 * @property {string} keywords
 * @property {string} [ogTitle] - Share-preview title (defaults to title)
 * @property {string} [ogDescription] - Share-preview description (defaults to description)
 * @property {string} imageAlt - Alt text for the share image
 * @property {string} appTitle - Short name for home-screen shortcuts
 * @property {"hero" | "maps-hero" | "about-hero"} heroClass - Hero element that gets the critical background colour
 * @property {boolean} [isHome] - The home page links to its own sections without a leading "/"
 * @property {"trailmaps" | "about"} [current] - Marks the matching primary nav link as the current page
 * @property {string} [resort] - Resort id for resort trail map pages (body data-resort)
 */

const {
  path,
  title,
  description,
  keywords,
  ogTitle = title,
  ogDescription = description,
  imageAlt,
  appTitle,
  heroClass,
  isHome = false,
  current,
  resort,
} = /** @type {Props} */ (Astro.props);

const canonical = canonicalUrl(path);
const ogImage = `${SITE}/og-image.png`;
const resortsHref = isHome ? "#resorts" : "/#resorts";
const criticalCss = `
  :root {
    --bg: #f2f5fd;
    --ink: #0a1338;
    --sky-1: #0b27b8;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #050920;
      --ink: #edf1ff;
      --sky-1: #01030d;
      color-scheme: dark;
    }
  }
  [data-theme="dark"] {
    --bg: #050920;
    --ink: #edf1ff;
    --sky-1: #01030d;
    color-scheme: dark;
  }
  body {
    font-family: "Mona Sans", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    background-color: var(--bg);
    color: var(--ink);
    margin: 0;
  }
  .${heroClass} {
    background-color: var(--sky-1);
  }
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    clip-path: inset(50%) !important;
    white-space: nowrap !important;
  }
`
  .replace(/\s*\n\s*/g, "")
  .replace(/\s*([{}:;,])\s*/g, "$1")
  .replace(/;}/g, "}");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Critical CSS for faster FCP/LCP */}
    <style is:inline set:html={criticalCss} />

    <link
      rel="preload"
      href="/fonts/mona-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Uphill Ski Colorado" />
    <meta name="robots" content="index, follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Uphill Ski Colorado" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {/* Theme colors and PWA */}
    <meta
      name="theme-color"
      content="#0b27b8"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#01030d"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="apple-mobile-web-app-title" content={appTitle} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <slot name="head" />
  </head>
  <body data-resort={resort}>
    <Sprite />
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>

    <header class="topbar" id="top">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
          <circle class="bm-sun" cx="30" cy="10.5" r="4.5"></circle>
          <path class="bm-peak" d="M2 35 15.5 11l6 9.5 4.5-6L38 35Z"></path>
          <path
            class="bm-track"
            d="M9.5 32.5 20 29.5l-7-2.6 8.5-2.8-5.2-2.7 4.4-1.6"
          ></path>
        </svg>
        <span class="brand-name">
          Uphill <span>Ski CO</span>
        </span>
      </a>
      <nav class="topnav" aria-label="Primary">
        <a href={resortsHref}>Resorts</a>
        <a
          href="/trailmaps.html"
          aria-current={current === "trailmaps" ? "page" : undefined}
        >
          Trail maps
        </a>
        <a
          href="/about.html"
          aria-current={current === "about" ? "page" : undefined}
        >
          About
        </a>
      </nav>
      <button
        class="theme-toggle"
        id="themeToggle"
        type="button"
        aria-pressed="false"
        aria-label="Dark mode"
        title="Toggle dark mode"
      >
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <g class="tt-stars">
            <circle cx="9" cy="9" r="1.1"></circle>
            <circle cx="31" cy="7" r=".9"></circle>
            <circle cx="34" cy="17" r="1"></circle>
            <circle cx="12" cy="18" r=".7"></circle>
          </g>
          <circle class="tt-sun" cx="20" cy="17" r="6.5"></circle>
          <path
            class="tt-moon"
            d="M23 10.7A7 7 0 1 0 26.2 20.3 5.5 5.5 0 0 1 23 10.7Z"
          ></path>
          <path class="tt-ridge" d="M0 40v-7l9.5-9 6 5 7.5-9.5L40 34v6Z"></path>
        </svg>
      </button>
    </header>

    <slot />

    <footer class="site-footer">
      <svg
        class="footer-ridge"
        viewBox="0 0 1000 80"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M0 13L18 31L31 12L44 27L78 42L89 19L102 37L137 29L150 8L164 22L204 59L218 59L233 62L269 35L280 11L291 33L328 35L342 19L358 30L389 56L398 49L406 51L440 49L455 34L472 47L512 61L524 55L538 59L569 38L579 19L589 37L623 60L637 57L652 57L684 56L693 55L702 60L733 40L746 16L760 34L795 32L807 8L820 29L851 37L860 27L870 34L902 33L914 19L928 34L964 55L977 57L991 55L1000 80L0 80Z"></path>
      </svg>
      <div class="footer-inner">
        <slot name="footer" />
        <nav class="footer-nav" aria-label="Footer">
          <a href={resortsHref}>Resorts</a>
          <a href="/trailmaps.html">Trail maps</a>
          <a href="/about.html">About</a>
          <a href="#top" class="to-top">
            Back to the summit
            <Icon name="arrow-up" />
          </a>
        </nav>
      </div>
    </footer>

    <slot name="end" />
  </body>
</html>
