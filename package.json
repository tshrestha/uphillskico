{
  "name": "uphillskico",
  "version": "1.0.0",
  "description": "Complete guide to uphill skiing policies at Colorado ski resorts",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-static.js && node scripts/generate-thumbs.js",
    "build": "npm run prebuild && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier --write \".\"",
    "thumbs": "node scripts/generate-thumbs.js",
    "texture": "node scripts/generate-texture.js"
  },
  "keywords": [
    "uphill skiing",
    "skinning",
    "Colorado",
    "ski resorts",
    "backcountry",
    "ski touring"
  ],
  "author": "Uphill Ski Colorado",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "vite": "^8.3.4",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-minify": "^3.0.0"
  },
  "engines": {
    "node": "^24"
  },
  "engineStrict": true
}
